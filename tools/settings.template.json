{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{VAULT}}/bin/cchook.py run {{HOME}}/.claude/hooks/cleanup-junk-sessions.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{VAULT}}/bin/cchook.py session-start",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{VAULT}}/bin/cchook.py stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{VAULT}}/bin/cchook.py session-end",
            "timeout": 190
          }
        ]
      }
    ]
  }
}
